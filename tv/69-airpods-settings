#!/bin/sh
# Adds the AirPods choices to Settings > Sound > Sound Out and to the Quick Settings Sound Out pills, by
# bind-mounting patched copies over the stock ones. Each copy mounts only when the stock file it was made from is
# unchanged, so a firmware update leaves stock menus in place. Touch $D/disabled to turn both off;
# run uninstall-settings.sh to remove them.
D=/var/lib/webosbrew/airpods-bridge/settings
[ -f "$D/disabled" ] && exit 0

# overlay COPY TARGET FINGERPRINTED_FILE
overlay() {
  grep -q " $2 " /proc/mounts && return 0
  [ -f "$1/$3" ] || return 0
  [ "$(sha256sum "$2/$3" | cut -d' ' -f1)" = "$(cat "$1.sha256" 2>/dev/null)" ] || return 0
  mount --bind "$1" "$2"
}

overlay "$D/app" /usr/palm/applications/com.palm.app.settings main.js
overlay "$D/QuickSettings" /usr/lib/qt5/qml/QuickSettings SoundOutServiceModel.qml
# Settings may already be loaded from the stock files; close it so the next open uses the patched copy.
luna-send -n 1 luna://com.webos.applicationManager/closeByAppId '{"id":"com.palm.app.settings"}' >/dev/null 2>&1
exit 0
